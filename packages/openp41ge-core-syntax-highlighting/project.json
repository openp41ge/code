{
  "name": "openp41ge-core-syntax-highlighting",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/openp41ge-core-syntax-highlighting/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "pnpm build",
        "cwd": "packages/openp41ge-core-syntax-highlighting"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm typecheck",
        "cwd": "packages/openp41ge-core-syntax-highlighting"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm clean",
        "cwd": "packages/openp41ge-core-syntax-highlighting"
      }
    }
  }
}
