{
  "id": "2026-10-09-chat-threads-per-workspace",
  "description": "Chat threads live in their workspaces: move each global chat thread to the workspace it names (else the oldest), and the old chats.json into the oldest workspace.",
  "release": "0.1.0-alpha.11",
  "steps": [
    {
      "op": "forEachEntry",
      "in": "chat-threads",
      "owner": {
        "fromJson": "thread.json",
        "field": "workspaceId",
        "otherwise": "oldestWorkspace"
      },
      "do": [
        { "op": "removeJsonField", "file": "${entry}/thread.json", "field": "workspaceId" },
        {
          "op": "if",
          "missing": "${owner.dataDir}/chat-threads/${entry.name}",
          "do": [
            {
              "op": "move",
              "from": "${entry}",
              "to": "${owner.dataDir}/chat-threads/${entry.name}"
            }
          ]
        }
      ]
    },
    { "op": "removeIfEmpty", "path": "chat-threads" },
    {
      "op": "forEachWorkspace",
      "only": "oldest",
      "do": [
        { "op": "importLegacyChats", "file": "chats.json", "workspace": "${workspace.dataDir}" }
      ]
    }
  ]
}
